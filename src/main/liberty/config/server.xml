<?xml version="1.0" encoding="UTF-8"?>
<server description="Server configuration for PostgreSQL connection">

    <featureManager>
        <feature>jakartaee-10.0</feature>
        <feature>microProfile-7.0</feature>
        <feature>mpOpenAPI-4.0</feature>
        <feature>mpHealth-4.0</feature>
        <!-- Persistencia -->
        <feature>persistence-3.1</feature>
         <feature>adminCenter-1.0</feature>
    </featureManager>



    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9090"
    />


    <dataSource id="defaultDataSource" jndiName="jdbc/Innova" type="javax.sql.DataSource">
        <jdbcDriver libraryRef="postgresql-library"/>

     <properties.postgresql
                user="${env.DB_USER}"
                password="${env.DB_PASSWORD}"
                databaseName="${env.DB_NAME}"
                serverName="${env.DB_HOST}"
                portNumber="5432"/>  

    <!--   para conexion local -->





    <connectionManager
        maxPoolSize="50"
        minPoolSize="10"
        maxIdleTime="600"
        connectionTimeout="30"
        reapTime="30"
        agedTimeout="0"
        connectionRetryInterval="10"
        failIfCannotConnect="true"
        disableBidiStatementCaching="false"
        validationTimeout="5"
    >
        <purgePolicy statementCache="true"/>
    </connectionManager>
    </dataSource>

    <library id="postgresql-library">
        <file name="${server.config.dir}/postgresql-42.7.6.jar"/>
    </library>

    <basicRegistry id="basic" realm="BasicRealm">
        <user name="${SV_USER}" password="${SV_PASSWORD}"/>
        <group name="${SV_GROUP}">
            <member name="${SV_MEMBER}"/>
        </group>
    </basicRegistry>

    <administrator-role>
    <user>${SV_USER}</user>
    </administrator-role>


</server>
